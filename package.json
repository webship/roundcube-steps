{
  "name": "@webship-js/roundcube-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for Roundcube webmail, a plugin for webship-js (Playwright and Cucumber): the login, the mail list and a message, writing, replying and sending, folders, the address book and its groups, and the settings (identities, responses, preferences).",
  "main": "tests/step-definitions/roundcube-defaults.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "roundcube",
    "webmail",
    "mail",
    "imap",
    "contacts",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "gherkin",
    "step-definitions",
    "e2e-testing"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/roundcube-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/roundcube-steps/issues"
  },
  "homepage": "https://github.com/webship/roundcube-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
